# Public application origin used for auth confirmation/reset redirects
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public Supabase configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase administration
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Server-only Paystack test/live secret
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Server-only Google Gemini / Veo API key
GEMINI_API_KEY=replace_me

# Provider kill switches. Keep false until entitlement/credit testing is complete.
ENABLE_REAL_VEO_GENERATION=false
ENABLE_REAL_IMAGE_GENERATION=false

# Future Cloudflare R2 media storage
R2_ACCOUNT_ID=replace_me
R2_BUCKET_NAME=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
